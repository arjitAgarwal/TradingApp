<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's picture: drawable-nodpi/app_logo.png, inset so every launcher shape (circle, squircle) shows
     all of it. To change the logo, replace that PNG with another square image of the same name. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/app_logo"
    android:inset="22dp" />
